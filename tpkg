#!/bin/sh
# Tiny third-party APK release checker for OpenWrt/ImmortalWrt.
# POSIX/ash compatible; depends on wget or curl, plus sed/awk/find.

set -u

VERSION="0.1.0"
PROG=${0##*/}
CONFIG_FILE=""
APK_DIR=""
DOWNLOAD_DIR=""
YES=0
DRY_RUN=0
QUIET=0
INTERACTIVE=0
ONLY_PACKAGE=""
KEEP_BACKUP=1
CONFIG_PATH=""
ARCH_PRIORITY=""
GITHUB_TOKEN_VALUE=""
TMP_ROOT=""

say() {
	[ "$QUIET" -eq 1 ] && return 0
	printf '%s\n' "$*"
}

warn() {
	printf '%s\n' "$*" >&2
}

die() {
	warn "error: $*"
	exit 1
}

usage() {
	cat <<EOF
$PROG $VERSION

Usage:
  $PROG [global options] check [package]
  $PROG [global options] update [package]
  $PROG [global options] install <package>
  $PROG [global options] list
  $PROG [global options] config
  $PROG [global options] token <github_token>

Global options:
  -c, --config FILE   Use config file
  -d, --dir DIR       APK directory, overrides config APK_DIR
  -y, --yes           Do not ask before replacing files
  -n, --dry-run       Show actions without downloading/replacing
  -i, --interactive   Kept for compatibility; update is interactive by default
  -q, --quiet         Less output
  -h, --help          Show this help

Examples:
  $PROG token github_pat_xxx
  $PROG check
  $PROG update
  $PROG update luci-app-lucky
  $PROG -d /mnt/sdc1/OpenWrt/apk update -y

Config search order:
  ./tpkg.conf
  /etc/config/tpkg
EOF
}

cleanup() {
	[ -n "${TMP_ROOT:-}" ] && [ -d "$TMP_ROOT" ] && rm -rf "$TMP_ROOT"
}

trap cleanup EXIT HUP INT TERM

have_cmd() {
	command -v "$1" >/dev/null 2>&1
}

need_cmd() {
	have_cmd "$1" || die "missing command: $1"
}

make_tmp_root() {
	if [ -z "$TMP_ROOT" ]; then
		TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/tpkg.XXXXXX") || die "failed to create temp dir"
	fi
}

default_config_file() {
	if [ -f "./tpkg.conf" ]; then
		printf '%s\n' "./tpkg.conf"
	elif [ -f "/etc/config/tpkg" ]; then
		printf '%s\n' "/etc/config/tpkg"
	else
		printf '%s\n' ""
	fi
}

load_config() {
	local file
	file=${CONFIG_FILE:-$(default_config_file)}
	[ -n "$file" ] || die "no config found; put tpkg.conf beside the script or at /etc/config/tpkg"
	[ -f "$file" ] || die "config not found: $file"
	CONFIG_PATH=$file

	[ -n "${APK_DIR:-}" ] || APK_DIR=$(yaml_scalar "apk_dir")
	[ -n "${DOWNLOAD_DIR:-}" ] || DOWNLOAD_DIR=$(yaml_scalar "download_dir")
	[ -n "${KEEP_BACKUP:-}" ] || KEEP_BACKUP=$(yaml_scalar "keep_backup")
	[ -n "${ARCH_PRIORITY:-}" ] || ARCH_PRIORITY=$(yaml_scalar "arch_priority")
	GITHUB_TOKEN_VALUE=${GITHUB_TOKEN:-}
	[ -n "${GITHUB_TOKEN_VALUE:-}" ] || GITHUB_TOKEN_VALUE=$(yaml_scalar "github_token")
	[ -n "${APK_DIR:-}" ] || die "APK_DIR is empty"
	[ -n "${DOWNLOAD_DIR:-}" ] || DOWNLOAD_DIR="/tmp/tpkg-downloads"
	[ -n "${KEEP_BACKUP:-}" ] || KEEP_BACKUP=1
	[ -n "${ARCH_PRIORITY:-}" ] || ARCH_PRIORITY="x86_64, all, any"
	item_lines >/dev/null || die "package config is invalid"
}

need_github_token() {
	[ -n "$GITHUB_TOKEN_VALUE" ] && return 0
	die "GitHub token is required; run: $PROG token <github_token>"
}

http_get() {
	local url out
	url=$1
	out=$2

	if have_cmd curl; then
		if [ -n "$GITHUB_TOKEN_VALUE" ]; then
			curl -fsSL \
				-H "Accept: application/vnd.github+json" \
				-H "Authorization: Bearer $GITHUB_TOKEN_VALUE" \
				-H "X-GitHub-Api-Version: 2022-11-28" \
				-H "User-Agent: tpkg/$VERSION" \
				-o "$out" "$url"
		else
			curl -fsSL \
				-H "Accept: application/vnd.github+json" \
				-H "User-Agent: tpkg/$VERSION" \
				-o "$out" "$url"
		fi
	elif have_cmd wget; then
		if [ -n "$GITHUB_TOKEN_VALUE" ]; then
			wget -q \
				--header="Accept: application/vnd.github+json" \
				--header="Authorization: Bearer $GITHUB_TOKEN_VALUE" \
				--header="X-GitHub-Api-Version: 2022-11-28" \
				--user-agent="tpkg/$VERSION" \
				-O "$out" "$url"
		else
			wget -q \
				--header="Accept: application/vnd.github+json" \
				--user-agent="tpkg/$VERSION" \
				-O "$out" "$url"
		fi
	else
		die "need curl or wget"
	fi
}

download_file() {
	local url out
	url=$1
	out=$2

	if have_cmd curl; then
		curl -fL --progress-bar -H "User-Agent: tpkg/$VERSION" -o "$out" "$url"
	elif have_cmd wget; then
		wget --user-agent="tpkg/$VERSION" -O "$out" "$url"
	else
		die "need curl or wget"
	fi
}

json_string_value() {
	local key
	key=$1
	sed -n 's/.*"'"$key"'":[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1
}

release_list_first_semver_tag() {
	awk '
		{
			text=text $0
		}
		END {
			while (match(text, /"tag_name":[[:space:]]*"v[0-9][^"]*"/)) {
				token=substr(text, RSTART, RLENGTH)
				sub(/^"tag_name":[[:space:]]*"/, "", token)
				sub(/"$/, "", token)
				print token
				exit
			}
			exit 1
		}
	' "$1"
}

github_release_json() {
	local repo mode cache list_cache safe tag
	repo=$1
	mode=${2:-latest}
	make_tmp_root
	safe=$(printf '%s' "$repo" | tr '/:' '__')
	cache="$TMP_ROOT/$safe.$mode.json"
	if [ ! -s "$cache" ]; then
		if [ "$mode" = "semver" ]; then
			list_cache="$TMP_ROOT/$safe.releases.json"
			http_get "https://api.github.com/repos/$repo/releases?per_page=30" "$list_cache" || return 1
			tag=$(release_list_first_semver_tag "$list_cache") || return 1
			http_get "https://api.github.com/repos/$repo/releases/tags/$tag" "$cache" || return 1
		else
			http_get "https://api.github.com/repos/$repo/releases/latest" "$cache" || return 1
		fi
	fi
	printf '%s\n' "$cache"
}

release_tag() {
	json_string_value "tag_name" < "$1"
}

release_assets() {
	# Output: filename<TAB>url
	awk '
		function json_value(token, prefix, value) {
			value=token
			sub("^" prefix, "", value)
			sub(/"$/, "", value)
			return value
		}
		{
			text=text $0
		}
		END {
			pos=index(text, "\"assets\":[")
			if (!pos) exit
			text=substr(text, pos + 10)
			while (match(text, /"name":[[:space:]]*"[^"]+"/)) {
				name_token=substr(text, RSTART, RLENGTH)
				name=json_value(name_token, "\"name\":[[:space:]]*\"")
				text=substr(text, RSTART + RLENGTH)
				if (match(text, /"browser_download_url":[[:space:]]*"[^"]+"/)) {
					url_token=substr(text, RSTART, RLENGTH)
					url=json_value(url_token, "\"browser_download_url\":[[:space:]]*\"")
					print name "\t" url
					text=substr(text, RSTART + RLENGTH)
				} else {
					exit
				}
			}
		}
	' "$1"
}

download_archive_asset() {
	local name url cache safe tmp_file
	name=$1
	url=$2
	make_tmp_root
	safe=$(printf '%s' "$name" | tr '/:?' '___')
	cache="$TMP_ROOT/$safe"
	if [ ! -s "$cache" ]; then
		tmp_file="$cache.part"
		rm -f "$tmp_file"
		download_file "$url" "$tmp_file" >/dev/null 2>&1 || {
			rm -f "$tmp_file"
			return 1
		}
		mv "$tmp_file" "$cache" || return 1
	fi
	printf '%s\n' "$cache"
}

archive_member_asset() {
	local archive_file pkg pattern priority
	archive_file=$1
	pkg=$2
	pattern=$3
	priority=$4
	tar -tzf "$archive_file" | awk -v pkg="$pkg" -v pat="$pattern" -v priority="$priority" '
		function trim(s) {
			sub(/^[ \t\r\n]+/, "", s)
			sub(/[ \t\r\n]+$/, "", s)
			return s
		}
		function basename(path, base) {
			base=path
			sub(/^.*\//, "", base)
			return base
		}
		function asset_ok(name) {
			if (name !~ /\.apk$/) return 0
			if (name ~ /\.ipk$/) return 0
			if (pat != "") return name ~ pat
			return index(name, pkg "-") == 1
		}
		function arch_match(name, arch) {
			arch=trim(arch)
			if (arch == "" || arch == "any") return 1
			if (arch == "all") return name ~ /[_-]all\.apk$/
			return name ~ ("[_-]" arch "\\.apk$")
		}
		BEGIN {
			gsub(/[\[\]]/, "", priority)
			count=split(priority, wanted, ",")
			if (count < 1) {
				count=3
				wanted[1]="x86_64"; wanted[2]="all"; wanted[3]="any"
			}
		}
		{
			name=basename($0)
			if (!asset_ok(name)) next
			for (i=1; i<=count; i++) {
				if (arch_match(name, wanted[i])) {
					if (best == "" || i < best_i) {
						best=name "\t" $0
						best_i=i
						if (i == 1) {
							print best
							found=1
							exit
						}
					}
					break
				}
			}
		}
		END {
			if (found) exit 0
			if (best != "") print best
			else exit 1
		}
	'
}

find_remote_asset() {
	local pkg repo pattern priority mode archive json archive_line archive_name archive_url archive_file member
	pkg=$1
	repo=$2
	pattern=$3
	priority=${4:-}
	mode=${5:-latest}
	archive=${6:-}
	[ -n "$priority" ] || priority="x86_64, all, any"
	json=$(github_release_json "$repo" "$mode") || return 1
	if [ -n "$archive" ]; then
		archive_line=$(release_assets "$json" | awk -F '\t' -v pat="$archive" '$1 ~ pat { print; found=1; exit } END { if (!found) exit 1 }') || return 1
		archive_name=${archive_line%%	*}
		archive_url=${archive_line#*	}
		archive_file=$(download_archive_asset "$archive_name" "$archive_url") || return 1
		member=$(archive_member_asset "$archive_file" "$pkg" "$pattern" "$priority") || return 1
		printf '%s\t%s\t%s\n' "${member%%	*}" "$archive_url" "${member#*	}"
		return 0
	fi
	release_assets "$json" | awk -F '\t' -v pkg="$pkg" -v pat="$pattern" -v priority="$priority" '
		function trim(s) {
			sub(/^[ \t\r\n]+/, "", s)
			sub(/[ \t\r\n]+$/, "", s)
			return s
		}
		function asset_ok(name) {
			if (name !~ /\.apk$/) return 0
			if (name ~ /\.ipk$/) return 0
			if (pat != "") return name ~ pat
			return index(name, pkg "-") == 1
		}
		function arch_match(name, arch) {
			arch=trim(arch)
			if (arch == "" || arch == "any") return 1
			if (arch == "all") return name ~ /[_-]all\.apk$/
			return name ~ ("[_-]" arch "\\.apk$")
		}
		BEGIN {
			gsub(/[\[\]]/, "", priority)
			count=split(priority, wanted, ",")
			if (count < 1) {
				count=3
				wanted[1]="x86_64"; wanted[2]="all"; wanted[3]="any"
			}
		}
		asset_ok($1) {
			for (i=1; i<=count; i++) {
				if (arch_match($1, wanted[i])) {
					if (best == "" || i < best_i) {
						best=$0
						best_i=i
						if (i == 1) {
							print best
							found=1
							exit
						}
					}
					break
				}
			}
		}
		END {
			if (found) exit 0
			if (best != "") print best
			else exit 1
		}
	'
}

yaml_clean_awk='
	function trim(s) {
		sub(/^[ \t\r\n]+/, "", s)
		sub(/[ \t\r\n]+$/, "", s)
		return s
	}
	function clean(s) {
		s=trim(s)
		if (s ~ /^'\''.*'\''$/) {
			sub(/^'\''/, "", s)
			sub(/'\''$/, "", s)
		} else if (s ~ /^".*"$/) {
			sub(/^"/, "", s)
			sub(/"$/, "", s)
		}
		return s
	}
'

yaml_scalar() {
	local key
	key=$1
	awk "$yaml_clean_awk"'
		$0 ~ "^[ \t]*" key "[ \t]*:" {
			value=$0
			sub("^[ \t]*" key "[ \t]*:[ \t]*", "", value)
			print clean(value)
			exit
		}
	' key="$key" "$CONFIG_PATH"
}

item_lines() {
	awk "$yaml_clean_awk"'
			function repo_from_release(url) {
				sub(/^https:\/\/github\.com\//, "", url)
				sub(/^http:\/\/github\.com\//, "", url)
				sub(/\/releases\/?$/, "", url)
				sub(/\/releases\/latest\/?$/, "", url)
				return url
			}
			function emit() {
				if (pkg != "" || release != "" || pattern != "" || mode != "" || archive != "") {
					if (pkg == "" || release == "") {
						printf "invalid config block near package=%s\n", pkg > "/dev/stderr"
						bad=1
					} else {
						if (mode == "") mode="latest"
						printf "%s|%s|%s|%s|%s\n", pkg, repo_from_release(release), pattern, mode, archive
					}
				}
				pkg=""; release=""; pattern=""; mode=""; archive=""
			}
			/^[ \t]*packages[ \t]*:/ { in_packages=1; next }
			!in_packages { next }
			/^[ \t]*$/ { next }
			/^[ \t]*#/ { next }
			/^[ \t]*-[ \t]*name[ \t]*:/ {
				emit()
				value=$0
				sub(/^[ \t]*-[ \t]*name[ \t]*:[ \t]*/, "", value)
				pkg=clean(value)
				next
			}
			{
				key=$1
				value=$0
				sub(/^[ \t]*/, "", key)
				sub(/[ \t]*:.*/, "", key)
				sub(/^[ \t]*[^:]+:[ \t]*/, "", value)
				value=trim(value)
				if (key == "release") release=clean(value)
				else if (key == "match") pattern=clean(value)
				else if (key == "release_mode") mode=clean(value)
				else if (key == "archive") archive=clean(value)
				else {
					printf "unknown config key: %s\n", key > "/dev/stderr"
					bad=1
				}
			}
			END { emit(); if (bad) exit 1 }
		' "$CONFIG_PATH"
}

package_exists() {
	local pkg
	pkg=$1
	item_lines | awk -F '|' -v p="$pkg" '$1 == p { found=1 } END { exit(found ? 0 : 1) }'
}

local_file_for() {
	local pkg
	pkg=$1
	# Keep this simple for ash. Config package names are exact filename prefixes.
	find "$APK_DIR" -maxdepth 1 -type f -name "$pkg-*.apk" 2>/dev/null | sort | tail -n 1
}

package_installed() {
	local pkg
	pkg=$1
	have_cmd apk || return 0
	apk info -e "$pkg" >/dev/null 2>&1
}

install_apk_file() {
	local pkg apk_file
	pkg=$1
	apk_file=$2

	if ! have_cmd apk; then
		warn "apk command not found; kept file only: ${apk_file##*/}"
		return 0
	fi

	apk add --allow-untrusted "$apk_file" || {
		warn "apk install failed: ${apk_file##*/}"
		return 2
	}
	package_installed "$pkg" || {
		warn "apk install did not register package: $pkg"
		return 2
	}
	say "system-installed: $pkg"
}

version_from_filename() {
	local pkg file base version
	pkg=$1
	file=$2
	base=${file##*/}
	version=${base#"$pkg-"}
	version=${version%.apk}
	case "$version" in
		*_*) version=${version%_*} ;;
	esac
	printf '%s\n' "$version"
}

version_from_apk_metadata() {
	local file
	file=$1
	[ -n "$file" ] && [ -f "$file" ] || return 1
	have_cmd tar || return 1

	tar -xOzf "$file" .PKGINFO 2>/dev/null | awk '
		/^pkgver = / {
			sub(/^pkgver = /, "")
			print
			found=1
			exit
		}
		END { if (!found) exit 1 }
	'
}

local_version_for() {
	local pkg file name version
	pkg=$1
	file=$2
	name=${3:-}

	version=$(version_from_apk_metadata "$file" 2>/dev/null) || version=""
	if [ -n "$version" ]; then
		printf '%s\n' "$version"
	elif [ -n "$name" ] && [ "$name" != "-" ]; then
		version_from_filename "$pkg" "$name"
	else
		printf '%s\n' "-"
	fi
}

remote_version_for() {
	local pkg local_name local_version remote_name
	pkg=$1
	local_name=$2
	local_version=$3
	remote_name=$4

	if [ "$local_name" = "$remote_name" ] && [ "$local_version" != "-" ]; then
		printf '%s\n' "$local_version"
	else
		version_from_filename "$pkg" "$remote_name"
	fi
}

status_line() {
	local state pkg local_name remote_name tag extra
	state=$1
	pkg=$2
	local_name=$3
	remote_name=$4
	tag=$5
	extra=$6

	printf '%-10s %-30s local=%-42s remote=%-42s tag=%s%s\n' \
		"$state" "$pkg" "${local_name:--}" "${remote_name:--}" "${tag:--}" "$extra"
}

check_one() {
	local pkg repo pattern mode archive json tag local_file local_name remote remote_name remote_url state extra
	pkg=$1
	repo=$2
	pattern=$3
	mode=$4
	archive=$5

	json=$(github_release_json "$repo" "$mode") || {
		status_line "ERROR" "$pkg" "-" "-" "-" " github api failed"
		return 2
	}
	tag=$(release_tag "$json")
	local_file=$(local_file_for "$pkg")
	local_name=${local_file##*/}
	[ -n "$local_file" ] || local_name="-"

	remote=$(find_remote_asset "$pkg" "$repo" "$pattern" "$ARCH_PRIORITY" "$mode" "$archive") || {
		status_line "MISSING" "$pkg" "$local_name" "-" "$tag" " no matching .apk asset"
		return 2
	}
	remote_name=$(printf '%s\n' "$remote" | awk -F '\t' '{ print $1 }')
	remote_url=$(printf '%s\n' "$remote" | awk -F '\t' '{ print $2 }')
	extra=""

	if [ "$local_name" = "-" ]; then
		state="NEW"
	elif ! package_installed "$pkg"; then
		state="INSTALL"
	elif [ "$local_name" = "$remote_name" ]; then
		state="OK"
	else
		state="UPDATE"
	fi

	if [ "$state" = "UPDATE" ] || [ "$state" = "NEW" ]; then
		extra=" url=$remote_url"
	fi
	status_line "$state" "$pkg" "$local_name" "$remote_name" "$tag" "$extra"

	case "$state" in
		OK) return 0 ;;
		*) return 1 ;;
	esac
}

run_check() {
	local filter rc items pkg repo pattern mode archive
	filter=${1:-}
	rc=0
	items=$(item_lines)

	while IFS='|' read -r pkg repo pattern mode archive; do
		[ -n "$pkg" ] || continue
		if [ -n "$filter" ] && [ "$filter" != "$pkg" ]; then
			continue
		fi
		check_one "$pkg" "$repo" "$pattern" "$mode" "$archive" || rc=1
	done <<EOF
$items
EOF

	return "$rc"
}

confirm_replace() {
	local prompt answer
	[ "$YES" -eq 1 ] && return 0
	prompt=$1
	printf '%s [y/N] ' "$prompt"
	read -r answer
	case "$answer" in
		y|Y|yes|YES) return 0 ;;
		*) return 1 ;;
	esac
}

replace_apk() {
	local pkg local_file new_file remote_name backup_dir
	pkg=$1
	local_file=$2
	new_file=$3
	remote_name=${new_file##*/}

	mkdir -p "$APK_DIR" || die "failed to create APK_DIR: $APK_DIR"

	if [ -n "$local_file" ] && [ -f "$local_file" ]; then
		if [ "$KEEP_BACKUP" = "1" ]; then
			backup_dir="$APK_DIR/.tpkg-backup"
			mkdir -p "$backup_dir" || die "failed to create backup dir"
			mv "$local_file" "$backup_dir/${local_file##*/}" || die "failed to backup ${local_file##*/}"
		else
			rm -f "$local_file" || die "failed to remove ${local_file##*/}"
		fi
	fi

	mv "$new_file" "$APK_DIR/$remote_name" || die "failed to move $remote_name into $APK_DIR"
	say "stored: $pkg -> $remote_name"
	install_apk_file "$pkg" "$APK_DIR/$remote_name"
}

update_one() {
	local pkg repo pattern mode archive force json tag local_file local_name remote remote_name remote_url remote_member target tmp_file archive_file
	pkg=$1
	repo=$2
	pattern=$3
	mode=$4
	archive=$5
	force=${6:-0}

	json=$(github_release_json "$repo" "$mode") || {
		status_line "ERROR" "$pkg" "-" "-" "-" " github api failed"
		return 2
	}
	tag=$(release_tag "$json")
	local_file=$(local_file_for "$pkg")
	local_name=${local_file##*/}
	[ -n "$local_file" ] || local_name="-"

	remote=$(find_remote_asset "$pkg" "$repo" "$pattern" "$ARCH_PRIORITY" "$mode" "$archive") || {
		status_line "MISSING" "$pkg" "$local_name" "-" "$tag" " no matching .apk asset"
		return 2
	}
	remote_name=$(printf '%s\n' "$remote" | awk -F '\t' '{ print $1 }')
	remote_url=$(printf '%s\n' "$remote" | awk -F '\t' '{ print $2 }')
	remote_member=$(printf '%s\n' "$remote" | awk -F '\t' '{ print $3 }')

	if [ "$local_name" = "$remote_name" ] && ! package_installed "$pkg"; then
		status_line "INSTALL" "$pkg" "$local_name" "$remote_name" "$tag" ""
		if [ "$DRY_RUN" -eq 1 ]; then
			say "dry-run: would install $local_file"
			return 1
		fi
		confirm_replace "Install $remote_name?" || {
			say "skipped: $pkg"
			return 1
		}
		install_apk_file "$pkg" "$local_file"
		return $?
	fi

	if [ "$local_name" = "$remote_name" ] && [ "$force" != "1" ]; then
		status_line "OK" "$pkg" "$local_name" "$remote_name" "$tag" ""
		return 0
	fi

	if [ "$local_name" = "$remote_name" ]; then
		status_line "REINSTALL" "$pkg" "$local_name" "$remote_name" "$tag" ""
	else
		status_line "UPDATE" "$pkg" "$local_name" "$remote_name" "$tag" ""
	fi
	case "$remote_name" in
		*.apk) ;;
		*) warn "refuse non-apk asset: $remote_name"; return 2 ;;
	esac
	case "$remote_name" in
		*.ipk) warn "refuse ipk asset: $remote_name"; return 2 ;;
	esac
	if [ "$DRY_RUN" -eq 1 ]; then
		say "dry-run: would download $remote_url"
		return 1
	fi

	confirm_replace "Replace $local_name with $remote_name?" || {
		say "skipped: $pkg"
		return 1
	}

	mkdir -p "$DOWNLOAD_DIR" || die "failed to create DOWNLOAD_DIR: $DOWNLOAD_DIR"
	target="$DOWNLOAD_DIR/$remote_name"
	tmp_file="$target.part"
	rm -f "$tmp_file"
	if [ -n "$remote_member" ]; then
		archive_file=$(download_archive_asset "${remote_url##*/}" "$remote_url") || {
			warn "download failed: $remote_url"
			return 2
		}
		tar -xOzf "$archive_file" "$remote_member" > "$tmp_file" || {
			rm -f "$tmp_file"
			warn "extract failed: $remote_member"
			return 2
		}
	else
		download_file "$remote_url" "$tmp_file" || {
			rm -f "$tmp_file"
			warn "download failed: $remote_url"
			return 2
		}
	fi
	[ -s "$tmp_file" ] || {
		rm -f "$tmp_file"
		warn "downloaded file is empty: $remote_name"
		return 2
	}
	mv "$tmp_file" "$target" || die "failed to finalize download"
	replace_apk "$pkg" "$local_file" "$target"
}

run_update() {
	local filter rc items pkg repo pattern mode archive
	filter=${1:-}
	rc=0
	items=$(item_lines)

	while IFS='|' read -r pkg repo pattern mode archive; do
		[ -n "$pkg" ] || continue
		if [ -n "$filter" ] && [ "$filter" != "$pkg" ]; then
			continue
		fi
		update_one "$pkg" "$repo" "$pattern" "$mode" "$archive" || rc=1
	done <<EOF
$items
EOF

	return "$rc"
}

collect_candidates() {
	local out filter items pkg repo pattern mode archive json tag local_file local_name remote remote_name state local_version remote_version
	out=$1
	filter=${2:-}
	items=$(item_lines)
	: > "$out" || die "failed to write candidate file"

	while IFS='|' read -r pkg repo pattern mode archive; do
		[ -n "$pkg" ] || continue
		if [ -n "$filter" ] && [ "$filter" != "$pkg" ]; then
			continue
		fi
		say "checking: $pkg"
		json=$(github_release_json "$repo" "$mode") || {
			status_line "ERROR" "$pkg" "-" "-" "-" " github api failed"
			continue
		}
		tag=$(release_tag "$json")
		local_file=$(local_file_for "$pkg")
		local_name=${local_file##*/}
		[ -n "$local_file" ] || local_name="-"
		remote=$(find_remote_asset "$pkg" "$repo" "$pattern" "$ARCH_PRIORITY" "$mode" "$archive") || {
			status_line "MISSING" "$pkg" "$local_name" "-" "$tag" " no matching .apk asset"
			continue
		}
		remote_name=$(printf '%s\n' "$remote" | awk -F '\t' '{ print $1 }')
		local_version=$(local_version_for "$pkg" "$local_file" "$local_name")
		remote_version=$(remote_version_for "$pkg" "$local_name" "$local_version" "$remote_name")
		if [ "$local_name" = "-" ]; then
			state="NEW"
		elif ! package_installed "$pkg"; then
			state="INSTALL"
		elif [ "$local_name" = "$remote_name" ]; then
			state="OK"
		else
			state="UPDATE"
		fi
		selected=0
		case "$state" in
			NEW|UPDATE|INSTALL) selected=1 ;;
		esac
		printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
			"$selected" "$pkg" "$repo" "$pattern" "$mode" "$archive" "$local_name" "$remote_name" "$tag" "$state" "$local_version" "$remote_version" >> "$out"
	done <<EOF
$items
EOF
}

draw_candidates() {
	local file index
	file=$1
	index=$2
	printf '\033[H\033[J'
	printf '%s\n' "tpkg interactive update"
	printf '%s\n\n' "Use Up/Down or j/k, Space toggle, a all, n none, Enter update, q quit."
	awk -F '|' -v idx="$index" '
		{
			cursor = (NR == idx ? ">" : " ")
			check = ($1 == "1" ? "[x]" : "[ ]")
			printf "%s %s %-9s %-30s %-24s -> %-24s tag=%s\n", cursor, check, $10, $2, $11, $12, $9
		}
	' "$file"
	printf '\n'
	awk -F '|' '
		$1 == "1" { selected++ }
		END { printf "Selected: %d / %d\n", selected + 0, NR + 0 }
	' "$file"
}

candidate_count() {
	awk 'END { print NR + 0 }' "$1"
}

toggle_candidate() {
	local file index tmp
	file=$1
	index=$2
	tmp="$file.tmp"
	awk -F '|' -v OFS='|' -v idx="$index" 'NR == idx { $1 = ($1 == "1" ? "0" : "1") } { print }' "$file" > "$tmp" &&
		mv "$tmp" "$file"
}

set_all_candidates() {
	local file value tmp
	file=$1
	value=$2
	tmp="$file.tmp"
	awk -F '|' -v OFS='|' -v value="$value" '{ $1=value; print }' "$file" > "$tmp" &&
		mv "$tmp" "$file"
}

run_selected_candidates() {
	local file selected selected_lines pkg repo pattern mode archive rc
	file=$1
	selected=$(awk -F '|' '$1 == "1" { count++ } END { print count + 0 }' "$file")
	[ "$selected" -gt 0 ] || {
		say "No packages selected."
		return 0
	}

	YES=1
	rc=0
	selected_lines=$(awk -F '|' '$1 == "1" { print $2 "|" $3 "|" $4 "|" $5 "|" $6 }' "$file")
	while IFS='|' read -r pkg repo pattern mode archive; do
		[ -n "$pkg" ] || continue
		update_one "$pkg" "$repo" "$pattern" "$mode" "$archive" 1 || rc=1
	done <<EOF
$selected_lines
EOF
	return "$rc"
}

read_key() {
	local key rest esc cr
	esc=$(printf '\033')
	cr=$(printf '\r')
	key=$(dd bs=1 count=1 2>/dev/null)
	case "$key" in
		"$esc")
			rest=$(dd bs=2 count=1 2>/dev/null)
			case "$rest" in
				"[A") printf '%s\n' "up" ;;
				"[B") printf '%s\n' "down" ;;
				*) printf '%s\n' "esc" ;;
			esac
			;;
		"$cr") printf '%s\n' "enter" ;;
		" ") printf '%s\n' "space" ;;
		"") printf '%s\n' "enter" ;;
		*) printf '%s\n' "$key" ;;
	esac
}

run_interactive_update() {
	local filter file count index old_stty key
	filter=${1:-}
	make_tmp_root
	file="$TMP_ROOT/candidates"
	collect_candidates "$file" "$filter"
	count=$(candidate_count "$file")
	[ "$count" -gt 0 ] || {
		say "All packages are up to date."
		return 0
	}

	if ! have_cmd stty; then
		run_line_update "$file"
		return $?
	fi

	if ! [ -r /dev/tty ] || ! have_cmd dd; then
		run_line_update "$file"
		return $?
	fi

	index=1
	old_stty=$(stty -g < /dev/tty 2>/dev/null)
	stty raw -echo < /dev/tty 2>/dev/null || return 1
	while :; do
		draw_candidates "$file" "$index"
		key=$(read_key < /dev/tty)
		case "$key" in
			up|k)
				if [ "$index" -gt 1 ]; then index=$((index - 1)); fi
				;;
			down|j)
				if [ "$index" -lt "$count" ]; then index=$((index + 1)); fi
				;;
			space)
				toggle_candidate "$file" "$index"
				;;
			a)
				set_all_candidates "$file" 1
				;;
			n)
				set_all_candidates "$file" 0
				;;
			q)
				stty "$old_stty" < /dev/tty 2>/dev/null || true
				printf '\n'
				say "Cancelled."
				return 0
				;;
			enter)
				stty "$old_stty" < /dev/tty 2>/dev/null || true
				printf '\n'
				run_selected_candidates "$file"
				return $?
				;;
		esac
	done
}

run_line_update() {
	local file answer selected tmp n
	file=$1
	while :; do
		printf '\n%s\n\n' "tpkg update"
		awk -F '|' '
			{
				check = ($1 == "1" ? "[x]" : "[ ]")
				printf "%2d. %s %-9s %-30s %-24s -> %-24s tag=%s\n", NR, check, $10, $2, $11, $12, $9
			}
		' "$file"
		printf '\n%s\n' "Enter numbers to toggle, a=all, n=none, y=update selected, q=quit"
		printf '> '
		read -r answer
		case "$answer" in
			q|Q)
				say "Cancelled."
				return 0
				;;
			a|A)
				set_all_candidates "$file" 1
				;;
			n|N)
				set_all_candidates "$file" 0
				;;
			y|Y|"")
				run_selected_candidates "$file"
				return $?
				;;
			*)
				tmp="$file.tmp"
				cp "$file" "$tmp" || return 1
				for n in $answer; do
					case "$n" in
						*[!0-9]*|"") ;;
						*) toggle_candidate "$tmp" "$n" ;;
					esac
				done
				mv "$tmp" "$file" || return 1
				;;
		esac
	done
}

run_install() {
	local pkg
	pkg=${1:-}
	[ -n "$pkg" ] || die "install needs a package name"
	package_exists "$pkg" || die "unknown package: $pkg"
	YES=1
	run_update "$pkg"
}

run_list() {
	local items pkg repo pattern mode archive local_file local_name local_ver
	items=$(item_lines)
	printf '%-30s %-36s %-42s %s\n' "PACKAGE" "REPO" "LOCAL_FILE" "LOCAL_VERSION"
	while IFS='|' read -r pkg repo pattern mode archive; do
		[ -n "$pkg" ] || continue
		local_file=$(local_file_for "$pkg")
		local_name=${local_file##*/}
		if [ -n "$local_file" ]; then
			local_ver=$(local_version_for "$pkg" "$local_file" "$local_name")
		else
			local_name="-"
			local_ver="-"
		fi
		printf '%-30s %-36s %-42s %s\n' "$pkg" "$repo" "$local_name" "$local_ver"
	done <<EOF
$items
EOF
}

set_github_token() {
	local token file tmp
	token=$1
	[ -n "$token" ] || die "token needs a GitHub token value"

	file=${CONFIG_FILE:-$(default_config_file)}
	[ -n "$file" ] || die "no config found; install tpkg.conf to /etc/config/tpkg first"
	[ -f "$file" ] || die "config not found: $file"

	tmp="$file.tmp.$$"
	awk -v token="$token" '
		/^[ \t]*github_token[ \t]*:/ {
			print "github_token: " token
			done=1
			next
		}
		{
			print
			if (!done && $0 ~ /^[ \t]*arch_priority[ \t]*:/) {
				print "github_token: " token
				done=1
			}
		}
		END {
			if (!done) print "github_token: " token
		}
	' "$file" > "$tmp" || {
		rm -f "$tmp"
		die "failed to write token"
	}
	mv "$tmp" "$file" || die "failed to update config: $file"
	chmod 600 "$file" 2>/dev/null || true
	say "GitHub token saved to $file"
}

show_config() {
	local token_state
	if [ -n "$GITHUB_TOKEN_VALUE" ]; then
		token_state="set"
	else
		token_state="empty"
	fi
	cat <<EOF
APK_DIR=$APK_DIR
DOWNLOAD_DIR=$DOWNLOAD_DIR
KEEP_BACKUP=$KEEP_BACKUP
ARCH_PRIORITY=$ARCH_PRIORITY
GITHUB_TOKEN=$token_state

Items:
EOF
	item_lines | awk -F '|' '{ printf "  %-30s repo=%-36s mode=%-8s pattern=%-16s archive=%s\n", $1, $2, $4, ($3 == "" ? "auto" : $3), ($5 == "" ? "-" : $5) }'
}

parse_args() {
	CMD=""
	while [ "$#" -gt 0 ]; do
		case "$1" in
			-c|--config)
				shift
				[ "$#" -gt 0 ] || die "--config needs a file"
				CONFIG_FILE=$1
				;;
			-d|--dir)
				shift
				[ "$#" -gt 0 ] || die "--dir needs a directory"
				APK_DIR=$1
				;;
			-y|--yes)
				YES=1
				;;
			-n|--dry-run)
				DRY_RUN=1
				;;
			-i|--interactive)
				INTERACTIVE=1
				;;
			-q|--quiet)
				QUIET=1
				;;
			-h|--help)
				usage
				exit 0
				;;
			check|update|install|list|config|token)
				CMD=$1
				shift
				if [ "$#" -gt 0 ]; then
					case "$1" in
						-*) ;;
						*) ONLY_PACKAGE=$1; shift ;;
					esac
				fi
				break
				;;
			*)
				die "unknown option or command: $1"
				;;
		esac
		shift
	done

	[ -n "$CMD" ] || CMD="check"

	# Allow -y after subcommand for muscle memory: tpkg update -y
	while [ "$#" -gt 0 ]; do
		case "$1" in
			-y|--yes) YES=1 ;;
			-n|--dry-run) DRY_RUN=1 ;;
			-i|--interactive) INTERACTIVE=1 ;;
			-q|--quiet) QUIET=1 ;;
			*) die "unknown trailing argument: $1" ;;
		esac
		shift
	done
}

main() {
	parse_args "$@"
	load_config

	[ -d "$APK_DIR" ] || {
		case "$CMD" in
			update|install) ;;
			*) die "APK_DIR does not exist: $APK_DIR" ;;
		esac
	}

	case "$CMD" in
		check)
			need_github_token
			[ "$INTERACTIVE" -eq 1 ] && die "check does not support -i; use: $PROG update"
			[ -n "$ONLY_PACKAGE" ] && package_exists "$ONLY_PACKAGE" || [ -z "$ONLY_PACKAGE" ] || die "unknown package: $ONLY_PACKAGE"
			run_check "$ONLY_PACKAGE"
			;;
		update)
			need_github_token
			[ -n "$ONLY_PACKAGE" ] && package_exists "$ONLY_PACKAGE" || [ -z "$ONLY_PACKAGE" ] || die "unknown package: $ONLY_PACKAGE"
			if [ "$YES" -eq 1 ] || [ "$DRY_RUN" -eq 1 ]; then
				run_update "$ONLY_PACKAGE"
			else
				run_interactive_update "$ONLY_PACKAGE"
			fi
			;;
		install)
			need_github_token
			run_install "$ONLY_PACKAGE"
			;;
		list)
			run_list
			;;
		config)
			show_config
			;;
		token)
			set_github_token "$ONLY_PACKAGE"
			;;
		*)
			die "unknown command: $CMD"
			;;
	esac
}

main "$@"
